# /etc/caddy/Caddyfile — replace EXAMPLE.COM and the bcrypt hash.
# Tested with Caddy v2.11.x. Generate the hash with: caddy hash-password

# Browser IDE (code-server on the remote machine)
code.EXAMPLE.COM {
	reverse_proxy 127.0.0.2:18080
}

# Web terminal (gotty). Basic auth lives here — gotty itself serves a
# persistent `screen` session, so keep exactly one strong auth layer in
# front. Bcrypt hash generated by `caddy hash-password`.
term.EXAMPLE.COM {
	basic_auth {
		admin REPLACE_WITH_BCRYPT_HASH
	}
	reverse_proxy 127.0.0.2:18081
}

# cc-connect web console (has its own token login on top)
cc.EXAMPLE.COM {
	reverse_proxy 127.0.0.2:18082
}

# Dev-server previews — two workable schemes, pick ONE.
#
# (a) One hostname per port (simple, each host gets its own cert):
#   p3000.EXAMPLE.COM  { reverse_proxy 127.0.0.2:3000 }
#   p5173.EXAMPLE.COM  { reverse_proxy 127.0.0.2:5173 }
#   p8000.EXAMPLE.COM  { reverse_proxy 127.0.0.2:8000 }
#
# (b) Port-in-subdomain with a single wildcard-ish block:
#   https://5173.p.EXAMPLE.COM → 127.0.0.2:5173
#   Needs a wildcard DNS record *.p.EXAMPLE.COM AND either the DNS-01
#   challenge (wildcard cert) or `tls { on_demand }` here.
*.p.EXAMPLE.COM {
	tls {
		on_demand
	}
	reverse_proxy 127.0.0.2:{http.request.host.labels.2}
}
